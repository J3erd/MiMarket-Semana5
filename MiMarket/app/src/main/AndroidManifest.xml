<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Permiso para comunicarse con Firebase y con el backend -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <!-- Semana 5: ubicación. Son permisos "peligrosos": además de declararse aquí, se piden al
         usuario EN TIEMPO DE EJECUCIÓN (MapaTiendasActivity) y solo después del aviso de privacidad.
         No se pide ubicación en segundo plano (principio de mínimo privilegio). -->
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />

    <!-- allowBackup="false": los datos locales (carrito, preferencias) no se copian a la nube de Google -->
    <application
        android:name=".MiMarketApplication"
        android:allowBackup="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:networkSecurityConfig="@xml/network_security_config"
        android:theme="@style/Theme.MiMarket"
        tools:targetApi="31">

        <!-- Semana 5 - Protección de API Keys: la clave de Google Maps NO está escrita aquí.
             ${MAPS_API_KEY} se reemplaza al compilar con el valor de local.properties (ignorado por git).
             La clave además está restringida en Google Cloud por paquete + huella SHA-1. -->
        <meta-data
            android:name="com.google.android.geo.API_KEY"
            android:value="${MAPS_API_KEY}" />

        <!-- 1. Splash (pantalla de arranque) -->
        <activity
            android:name=".view.SplashActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- 2. Inicio de sesión -->
        <activity
            android:name=".view.InicioSesionActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />

        <!-- 4. Aviso de Privacidad -->
        <activity
            android:name=".view.AvisoPrivacidadActivity"
            android:exported="false" />

        <!-- 5. Home (sesión iniciada) -->
        <activity
            android:name=".view.HomeActivity"
            android:exported="false"
            android:launchMode="singleTop" />

        <!-- 19. Confirmar pedido -->
        <activity
            android:name=".view.ConfirmarPedidoActivity"
            android:exported="false" />

        <!-- Semana 5: registro de cuenta (Firebase Authentication) -->
        <activity
            android:name=".view.RegistroActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />

        <!-- 2. Catálogo de productos -->
        <activity
            android:name=".view.CatalogoActivity"
            android:exported="false"
            android:launchMode="singleTop" />

        <!-- Detalle de producto -->
        <activity
            android:name=".view.ProductoDetalleActivity"
            android:exported="false" />

        <!-- Formulario de producto (registrar / editar) -->
        <activity
            android:name=".view.ProductoFormActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />

        <!-- 3. Resumen de compra (carrito) -->
        <activity
            android:name=".view.ResumenCompraActivity"
            android:exported="false" />

        <!-- 4. Compra realizada -->
        <activity
            android:name=".view.CompraRealizadaActivity"
            android:exported="false" />

        <!-- Historial de pedidos (Firestore: usuarios/{uid}/pedidos) -->
        <activity
            android:name=".view.HistorialComprasActivity"
            android:exported="false" />

        <!-- Semana 5: mapa de tiendas y ubicación -->
        <activity
            android:name=".view.MapaTiendasActivity"
            android:exported="false" />

        <!-- Semana 5: perfil de usuario (privacidad, cerrar sesión, eliminar cuenta) -->
        <activity
            android:name=".view.PerfilActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />

    </application>

</manifest>
